namespace net.akehurst.omg.mof.gen.template

import net.akehurst.omg.mof.gen.simple

format PackageImport {
    MofPackage -> "import ${TARGET_PACKAGE}.api.${qualifiedName}.*"
}

format DerivationFun {
    MofProperty -> {
        body := $nothing == derivationKotlin ? "TODO(\"Derivation of '${qualifiedName}' is not implemented\")" : derivationKotlin
        "
          /**
           * Derivation of ${parentType.name}.${name}
           * ${derivationDoc}
           */
          fun ${parentType.validName}_${validName}(self: ${parentType.validName}): ${validTypeName} = $body
        "
    }
}

format DerivationsOfClass {
    MofClass -> "$[attribute.filter({it -> it.isDerivedOnly}) sep $EOL via DerivationFun]"
}

format ApiPackageDerivationsFile {
    #output: 'MofPackage -> "api/$qualifiedPath/${name}_Derivations.kt"'

    MofModel -> "${packageList.filter({it -> false == it.isEmpty})}"
    MofPackage -> when {
        EXCLUDE_PACKAGE.contains(qualifiedName) -> ''
        else -> "
            $COPYRIGHT

            // *** Generated code do NOT manually edit. ***
            package ${TARGET_PACKAGE}.api.${qualifiedName}

            import net.akehurst.kotlinx.collections.OrderedSet
            import net.akehurst.kotlinx.collections.toOrderedSet
            $[allImportWithSubtypes sep $EOL via PackageImport]

            /**
             * Derivations of the derived (not union) properties of the classes in package $qualifiedName.
             * They use only the api interfaces, so they are the same for every implementation.
             * A derivation whose OCL could not be translated is a TODO.
             */
            object ${name}_Derivations {
                $[classes sep $EOL via DerivationsOfClass]
            }
        "
    }
}
