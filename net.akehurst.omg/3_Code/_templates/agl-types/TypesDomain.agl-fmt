namespace net.akehurst.omg.mof.gen.template

import net.akehurst.omg.mof.gen.simple

format PackageImport {
    MofPackage -> "import ${TARGET_PACKAGE}.api.${qualifiedName}.*"
}

format ApiPackageFile {
    #output: 'MofModel -> "agl/${name}TypesDomain.kt"'

    MofModel -> "
        $COPYRIGHT

        // *** Generated code do NOT manually edit. ***
        package ${TARGET_PACKAGE}.agl.types

        import ${TARGET_PACKAGE}.api.${name}_ModelFactory
        import ${TARGET_PACKAGE}.ram.${validName}_ModelFactoryRam
        $[packageList.filter({it -> false == it.isEmpty}) sep $EOL via PackageImport]
        import net.akehurst.language.types.builder.typesDomain

        class ${name}TypesDomain(factory: ${name}_ModelFactory = ${validName}_ModelFactoryRam(\"${name}\")) {
            val types = typesDomain(\"${name}\", true) {
                $[packageList.filter({it -> false == it.isEmpty}) sep $EOL]
            }
        }
    "

    MofPackage -> "
      namespace(\"$qualifiedName\") {
          $[enums sep $EOL]
          $[classes.filter({it -> false == it.isAbstract}) sep $EOL]
      }
    "

    MofEnum -> "
      enum(\"$name\", listOf(/*TODO*/), implementation = ${validName}::class)
    "

    MofClass -> "
      data(\"$name\", implementation = ${validName}::class) {
        constructor_ {
          parameter(setOf(REF, VAL), \"_identity\", \"Any\", false, accessor = ${validName}::_identity)
          execution { args -> factory.${parentPackage.qualifiedName}.${validName}_construct(args[0] ?: error(\"${name} needs an identity\")) }
        }
      }
    "
}
