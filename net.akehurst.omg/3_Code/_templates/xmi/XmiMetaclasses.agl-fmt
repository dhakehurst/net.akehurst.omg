// Generates, for each metaclass, what the XMI reader needs to create its instances and set their
// properties by the names used in XMI (see XmiGenClass/XmiGenFeature in the xmi module).

namespace net.akehurst.omg.mof.gen.template

import net.akehurst.omg.mof.gen.simple

format XmiFeature {
    MofProperty -> {
        owner := parentType.validName
        many := isCollection ? 'true' : 'false'
        when {
            isComputed -> "XmiGenFeature.derived(\"$nameInXmi\", \"${type.name}\", $many)"
            type is MofEnum -> when {
                isSingle -> "XmiGenFeature.data(\"$nameInXmi\", \"${type.name}\", false, { t -> ${type.validName}_xmiLiterals[t] }) { o, v -> (o as $owner).${validName}Value.mutable.set(v as ${type.validName}) }"
                else -> "XmiGenFeature.data(\"$nameInXmi\", \"${type.name}\", true, { t -> ${type.validName}_xmiLiterals[t] }) { o, v -> (o as $owner).${validName}.mutable.add(v as ${type.validName}) }"
            }
            type.isPrimitive -> when {
                isSingle -> "XmiGenFeature.data(\"$nameInXmi\", \"${type.validName}\", false, { t -> XmiDataConversion.convertKotlin(\"${type.validName}\", t) }) { o, v -> (o as $owner).${validName}Value.mutable.set(v as ${type.validName}) }"
                else -> "XmiGenFeature.data(\"$nameInXmi\", \"${type.validName}\", true, { t -> XmiDataConversion.convertKotlin(\"${type.validName}\", t) }) { o, v -> (o as $owner).${validName}.mutable.add(v as ${type.validName}) }"
            }
            isComposite -> when {
                isSingle -> "XmiGenFeature.composite(\"$nameInXmi\", \"${type.name}\", false) { o, v -> (o as $owner).${validName}Value.mutable.set(v as ${type.validName}) }"
                else -> "XmiGenFeature.composite(\"$nameInXmi\", \"${type.name}\", true) { o, v -> (o as $owner).${validName}.mutable.add(v as ${type.validName}) }"
            }
            isReference -> when {
                isSingle -> "XmiGenFeature.reference(\"$nameInXmi\", \"${type.name}\", false) { o, id, r -> (o as $owner).${validName}Reference.mutable.set(id, r as ${type.validName}?) }"
                else -> "XmiGenFeature.reference(\"$nameInXmi\", \"${type.name}\", true) { o, id, r -> (o as $owner).${validName}Reference.mutable.add(ReferenceImmutable(id, r as ${type.validName}?)) }"
            }
            else -> "// ERROR: $nameInXmi"
        }
    }
}

// Kotlin allows a trailing comma in an argument list
format XmiFeatureItem {
    MofProperty -> "${$self via XmiFeature},"
}

format XmiEnumLiterals {
    MofEnum -> "
        internal val ${validName}_xmiLiterals: Map<String, ${validName}> = mapOf($[literals.map({it -> "\"${it.name}\" to ${validName}.${it.validName}"}) sep ', '])
    "
}

format XmiClass {
    MofClass -> {
        abs := isAbstract ? 'true' : 'false'
        ctor := isAbstract ? 'null' : "{ f, id -> f.${parentPackage.qualifiedName}.${validName}_construct(id) }"
        "
            private fun ${validName}_xmi() = XmiGenClass(
                \"$name\", $abs, listOf($[superTypes.map({it -> "\"${it.name}\""}) sep ', ']), $ctor,
                listOf(
                    $[ownedAttribute sep $EOL via XmiFeatureItem]
                )
            )
        "
    }
}

format XmiClassRef {
    MofClass -> "${validName}_xmi(),"
}

format PackageImport {
    MofPackage -> "import ${TARGET_PACKAGE}.api.${qualifiedName}.*"
}

format XmiPackageFile {
    #output: 'MofPackage -> "xmi/$qualifiedPath/${name}_XmiClasses.kt"'

    MofPackage -> when {
        EXCLUDE_PACKAGE.contains(qualifiedName) -> ''
        else -> "
            $COPYRIGHT

            // *** Generated code do NOT manually edit. ***
            package ${TARGET_PACKAGE}.xmi.${qualifiedName}

            import net.akehurst.kotlinx.collections.CollectionExt.mutable
            import net.akehurst.kotlinx.collections.ListExt.mutable
            import net.akehurst.kotlinx.collections.SetExt.mutable
            import net.akehurst.kotlinx.collections.OrderedSetExt.mutable
            import net.akehurst.kotlinx.utils.ReferenceImmutable
            import net.akehurst.kotlinx.utils.ReferenceExt.mutable
            import net.akehurst.kotlinx.utils.ValueExt.mutable
            import ${TARGET_PACKAGE}.xmi.XmiDataConversion
            import ${TARGET_PACKAGE}.xmi.XmiGenClass
            import ${TARGET_PACKAGE}.xmi.XmiGenFeature
            $[model.packageList.filter({it -> false == it.isEmpty}).filter({it -> false == EXCLUDE_PACKAGE.contains(it.qualifiedName)}) sep $EOL via PackageImport]

            $[enums sep $EOL via XmiEnumLiterals]

            internal object ${validName}_XmiClasses {

                val all: List<XmiGenClass> get() = listOf(
                    $[classes sep $EOL via XmiClassRef]
                )

                $[classes sep $EOL via XmiClass]
            }
        "
    }
}

format XmiPackageRef {
    MofPackage -> "${TARGET_PACKAGE}.xmi.${qualifiedName}.${validName}_XmiClasses.all,"
}

format XmiModelFile {
    #output: 'MofModel -> "xmi/${name}_XmiMetaclasses.kt"'

    MofModel -> "
        $COPYRIGHT

        // *** Generated code do NOT manually edit. ***
        package ${TARGET_PACKAGE}.xmi

        /**
         * The metaclasses of ${name}, as the XMI reader needs them.
         */
        internal object ${name}_XmiMetaclasses {
            val all: List<XmiGenClass> by lazy {
                listOf(
                    $[packageList.filter({it -> false == it.isEmpty}).filter({it -> false == EXCLUDE_PACKAGE.contains(it.qualifiedName)}) sep $EOL via XmiPackageRef]
                ).flatten()
            }
        }

        ${packageList.filter({it -> false == it.isEmpty}) via XmiPackageFile}
    "
}
